<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
  <parent>
    <artifactId>iottree-parent</artifactId>
    <groupId>org.iottree</groupId>
    <version>3.0.0-alpha</version>
  </parent>

  <artifactId>iottree-server-api</artifactId>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencies>
  
	  <dependency>
		    <groupId>org.iottree</groupId>
		    <artifactId>iottree-core</artifactId>
		    <version>${project.version}</version>
		</dependency>
		
		<dependency>
		    <groupId>org.iottree</groupId>
		    <artifactId>iottree-driver-common</artifactId>
		    <version>${project.version}</version>
		</dependency>
		
		<dependency>
		    <groupId>org.iottree</groupId>
		    <artifactId>iottree-driver-opc</artifactId>
		    <version>${project.version}</version>
		</dependency>
		
		<dependency>
		    <groupId>org.iottree</groupId>
		    <artifactId>iottree-ext-basic</artifactId>
		    <version>${project.version}</version>
		</dependency>
		
		<dependency>
		    <groupId>org.iottree</groupId>
		    <artifactId>iottree-ext-opcda</artifactId>
		    <version>${project.version}</version>
		</dependency>
		
		<dependency>
		    <groupId>org.iottree</groupId>
		    <artifactId>iottree-ext-pro</artifactId>
		    <version>${project.version}</version>
		</dependency>
		
		<dependency>
	        <groupId>io.undertow</groupId>
	        <artifactId>undertow-core</artifactId>
	        <version>2.3.12.Final</version>
	    </dependency>
    
		<!--
			<dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.17.1</version>
    </dependency>
    
		<dependency>
	        <groupId>io.quarkus</groupId>
	        <artifactId>quarkus-resteasy-jackson</artifactId>
	        <version>3.19.0</version>
	    </dependency>
    -->
  </dependencies>
<profiles>
    <profile>
        <id>native</id> 
  <build>
        <plugins>
        
	        <plugin>
	            <groupId>org.apache.maven.plugins</groupId>
	            <artifactId>maven-jar-plugin</artifactId>
	            <configuration>
	                <skipIfEmpty>true</skipIfEmpty>
	            </configuration>
	            <executions>
	                <execution>
	                    <id>default-jar</id>
	                    <phase>none</phase> 
	                </execution>
	            </executions>
	        </plugin>
        
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <version>0.10.1</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <id>build-native</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <phase>package</phase>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>org.iottree.server_api.Server</mainClass>
                    <imageName>server-api</imageName>
                    
                    <buildArgs>
                    	<buildArg>-H:+ReportExceptionStackTraces</buildArg>
                    	<buildArg>-H:+AllowDeprecatedBuilderClassesOnImageClasspath</buildArg>
                    	<buildArg>--trace-class-initialization=org.slf4j.LoggerFactory</buildArg>
                    	<buildArg>--initialize-at-build-time=io.grpc.netty.shaded.io.netty.util.internal.logging.Slf4JLoggerFactory</buildArg>
						<buildArg>--initialize-at-build-time=io.grpc.netty.shaded.io.netty.util.internal.logging.JdkLogger</buildArg>
						<buildArg>--initialize-at-run-time=sun.security.util.Password$ConsoleHolder</buildArg>
						<buildArg>--initialize-at-build-time=kotlin.annotation.AnnotationTarget,kotlin.annotation.AnnotationRetention</buildArg>
						
						<buildArg>--language:js</buildArg>
						<!--
						<buildArg>-H:IncludeResources=org/iottree/.*\.xml$</buildArg>
						-->
						<buildArg>-H:IncludeResources=.*iottree.*\.xml$</buildArg>
						<buildArg>-H:IncludeResources=logging\.properties</buildArg>
						<buildArg>-H:Log=registerResource:3</buildArg>
						<buildArg>-H:IncludeLocales=en</buildArg>
						<buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                    	<buildArg>-J-Xmx18g</buildArg>
                    	
                    </buildArgs>
                </configuration>
            </plugin>
            
            
        </plugins>
    </build>
    </profile>
</profiles>
</project>
